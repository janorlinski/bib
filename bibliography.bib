@article{HONG1997115,
  title        = {{Abundance of \ensuremath{\Delta} resonances in 58Ni + 58Ni collisions between 1 and 2 AGeV}},
  abstract     = {Charged pion spectra measured in 58Ni58Ni collisions at 1.06, 1.45 and 1.93 AGeV are interpreted in terms of a thermal model including the decay of \ensuremath{\Delta} resonances. The transverse momentum spectra of pions are well reproduced by adding the pions originating from the \ensuremath{\Delta} -resonance decay to the component of thermal pions, deduced from the high transverse momentum part of the pion spectra. About 10 and 18\% of the nucleons are excited to \ensuremath{\Delta} states at freeze-out for beam energies of 1 and 2 AGeV, respectively.},
  author       = {Hong, B. and Herrmann, N. and Ritman, J.L. and Best, D. and Gobbi, A. and Hildenbrand, K.D. and Kirejczyk, M. and Leifels, Y. and Pinkenburg, C. and Reisdorf, W. and Sch{\"u}ll, D. and Sodan, U. and Wang, G.S. and Wienold, T. and Alard, J.P. and Amouroux, V. and Bastid, N. and Belyaev, I. and Berek, G. and Biegansky, J. and Buta, A. and Coffin, J.P. and Crochet, P. and Dona, R. and Dupieux, P. and Eskef, M. and Fintz, P. and Fodor, Z. and Fraysse, L. and Genoux-Lubain, A. and Goebels, G. and Guillaume, G. and H{\"a}fele, E. and Jundt, F. and Kecskemeti, J. and Korolija, M. and Kotte, R. and Kuhn, C. and Lebedev, A. and Legrand, I. and Maazouzi, C. and Manko, V. and M{\"o}sner, J. and Mohren, S. and Neubert, W. and Pelte, D. and Petrovici, M. and Pras, P. and Rami, F. and Roy, C. and Seres, Z. and Sikora, B. and Simion, V. and Siwek-Wilczy{\'n}ska, K. and Somov, A. and Tizniti, L. and Trzaska, M. and Vasiliev, M.A. and Wagner, P. and Wohlfarth, D. and Zhilin, A.},

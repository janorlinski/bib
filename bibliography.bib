@article{Arnaldi2009,
  title        = {{NA60 results on thermal dimuons}},
  abstract     = {The NA60 experiment at the CERN SPS has measured muon pairs with unprecedented precision in 158{\thinspace}A GeV In--In collisions. A strong excess of pairs above the known sources is observed in the whole mass region 0.2<M<2.6 GeV. The mass spectrum for M<1 GeV is consistent with a dominant contribution from $\pi$+$\pi$−{\textrightarrow}$\rho${\textrightarrow}$\mu$+$\mu$− annihilation. The associated $\rho$ spectral function shows a strong broadening, but essentially no shift in mass. For M>1 GeV, the excess is found to be prompt, not due to enhanced charm production, with pronounced differences to Drell--Yan pairs. The slope parameter Teff associated with the transverse momentum spectra rises with mass up to the $\rho$, followed by a sudden decline above. The rise for M<1 GeV is consistent with radial flow of a hadronic emission source. The seeming absence of significant flow for M>1 GeV and its relation to parton--hadron duality is discussed in detail, suggesting a dominantly partonic emission source in this region. A comparison of the data to the present status of theoretical modeling is also contained. The accumulated empirical evidence, including also a Planck-like shape of the mass spectra at low pTand the lack of polarization, is consistent with a global interpretation of the excess dimuons as thermal radiation. We conclude with first results on $\omega$ in-medium effects.},
  author       = {{NA60 Collaboration} and Arnaldi, R. and Banicz, K. and Borer, K. and Castor, J. and Chaurand, B. and Chen, W. and Cical{\`o}, C. and Colla, A. and Cortese, P. and Damjanovic, S. and David, A. and de Falco, A. and Devaux, A. and Ducroux, L. and En'yo, H. and Fargeix, J. and Ferretti, A. and Floris, M. and F{\"o}rster, A. and Force, P. and Guettet, N. and Guichard, A. and Gulkanian, H. and Heuser, J. M. and Keil, M. and Kluberg, L. and Li, Z. and Louren{\c c}o, C. and Lozano, J. and Manso, F. and Martins, P. and Masoni, A. and Neves, A. and Ohnishi, H. and Oppedisano, C. and Parracho, P. and Pillot, P. and Poghosyan, T. and Puddu, G. and Radermacher, E. and Ramalhete, P. and Rosinsky, P. and Scomparin, E. and Seixas, J. and Serci, S. and Shahoyan, R. and Sonderegger, P. and Specht, H. J. and Tieulent, R. and Usai, G. and Veenhof, R. and W{\"o}hri, H. K.},
  journal      = {Eur. Phys. Jour. C},
  volume       = 61,
  year         = 2009,
  month        = jun,

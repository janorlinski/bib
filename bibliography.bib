@article{Reichle2006,
  title        = {{Experimental purification of two-atom entanglement}},
  author       = {Reichle, R. and Leibfried, D. and Knill, E. and Britton, J. and Blakestad, R. B. and Jost, J. D. and Langer, C. and Ozeri, R. and Seidelin, S. and Wineland, D. J.},
  abstract     = {Entanglement between physically separate quantum systems makes quantum communication and information processing possible. However, transporting one member of an entangled pair of quantum bits (photons or atoms, for example) to a different location causes the quality of the entanglement to be reduced by decoherence. One solution is to 'purify' the entanglement after the particles have been separated. This has now been achieved using beryllium ions: a high-fidelity entangled pair was distilled from two lower fidelity pairs in an efficient, non-destructive manner.},
  day          = {01},
